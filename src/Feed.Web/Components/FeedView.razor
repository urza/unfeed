<Shell Title="Feed" Stamp="@Stamp" Background="@Background" Blur="Model.Instance.Config.Backgrounds.BlurPx">
<header class="toolbar glass">
 <div class="toolbar-head"><div><div class="brand"><Mark/><strong>Feed</strong></div><small>@Model.VisibleCount posts · @Model.Friends friends
@if(Model.AdsDropped>0){<span> · @Model.AdsDropped ads dropped</span>}
@if (LastCollect is { } last) { <span> · last collect @FeedQuery.Relative(last.FinishedAt) ago (+@last.PostsNew)</span> }</small></div><nav class="inspection">@if (Model.Instance.Config.Llm.Enabled) { <a class="@(Model.Scope == "unsorted" ? "active" : "")" href="@(Link(Model.View, Model.Platform, "unsorted"))" title="Posts waiting for the model's verdict; not shown in any category view">Unsorted (@Model.UnsortedCount)</a> }<a href="@(Link(Model.View, Model.Platform, "hidden"))" class="@(Model.Scope == "hidden" ? "active" : "")">Hidden (@Model.HiddenCount)</a><a href="/debug" title="@DebugTitle">Debug@if(HasDiagnostics){<span class="debug-dot" role="img" aria-label="Diagnostics to review"></span>}</a></nav></div>
 <div class="toolbar-row">
  <nav class="pills views desktop">@foreach (var view in Views) { <a class="@(view.Key == Model.View ? "active" : "")" href="@Link(view.Key, Model.Platform)">@view.Label</a> }</nav>
  <details class="dropdown mobile view-picker"><summary>@Views.First(v => v.Key == Model.View).Label <span class="caret">⌄</span></summary><div class="menu">@foreach (var view in Views) { <a class="@(view.Key == Model.View ? "active" : "")" href="@Link(view.Key, Model.Platform)">@view.Label</a> }<a href="/debug" title="@DebugTitle">Debug@if(HasDiagnostics){<span class="debug-dot" role="img" aria-label="Diagnostics to review"></span>}</a><a href="@Link(Model.View, Model.Platform, "hidden")">Hidden (@Model.HiddenCount)</a>@if(Model.Instance.Config.Llm.Enabled){<a href="@Link(Model.View, Model.Platform, "unsorted")">Unsorted (@Model.UnsortedCount)</a>}</div></details>
  <nav class="pills platforms desktop"><a href="@Link(Model.View, null)" aria-label="All platforms" title="All platforms">▦</a>@foreach(var p in PickerPlatforms){<a href="@Link(Model.View,p)" class="@((p == Model.Platform ? "active " : "") + (!Model.Instance.Config.Enabled(p) ? "paused" : ""))" title="@PlatformTitle(p)" aria-label="@p">@(p == "facebook" ? "f" : "◎")</a>}</nav>
  <details class="dropdown mobile"><summary title="@($"Platform: {Model.Platform ?? "all"}")">@(Model.Platform == "facebook" ? "f" : Model.Platform == "instagram" ? "◎" : "▦")</summary><div class="menu"><a class="@(Model.Platform is null ? "active" : "")" href="@Link(Model.View,null)">All platforms</a>@foreach(var p in PickerPlatforms){<a class="@((p == Model.Platform ? "active " : "") + (!Model.Instance.Config.Enabled(p) ? "paused" : ""))" title="@PlatformTitle(p)" href="@Link(Model.View,p)">@p</a>}</div></details>
  <form action="/read" method="post" class="read"><button class="ghost" title="Mark all read"><span class="desktop">Mark all read</span><span class="mobile">✓</span></button></form>
  <details class="dropdown collect"><summary><span class="desktop">@CollectLabel</span><span class="mobile">@CollectLabel.Replace("Collect requested", "Requested")</span> <span class="caret">⌄</span></summary><div class="menu"><form action="/collect" method="post"><button disabled="@(!Enabled.Any(Open))" title="@(Enabled.Any(Open) ? "Queue home collection on enabled platforms" : "No enabled platform is ready: check requests, running collects and re-login")">Collect now</button></form>@foreach(var p in Enabled){@foreach(var mode in Platforms.Modes){<form action="@($"/collect/{p}/{mode}")" method="post"><button disabled="@(!Open(p))" title="@Reason(p)">Collect @p · @mode.Replace('_',' ')</button></form>}}</div></details>
 </div>
</header>
@foreach (var state in Model.States.Where(s => s.NeedsRelogin)) { <aside class="banner">Re-login needed: @state.Platform. Run <code>Feed.Cli login --platform @state.Platform</code> and finish the login in the noVNC browser.</aside> }
@if(Model.Scope != "live"){<aside class="banner">@(Model.Scope == "hidden" ? $"Debug: showing {Model.HiddenCount} hidden posts ({Model.TotalHidden} total). Each card states which filter hid it and why." : $"Unsorted: {Model.TotalUnsorted} posts waiting for a judgment of their current content ({Model.UnsortedCount} in this scope).") <a href="@Link(Model.View,Model.Platform)">Back to feed</a></aside>}
@if(Model.Items.Length == 0){<section class="empty glass"><p>@Model.EmptyMessage</p>@if(Model.Platform is not null){<a href="@Link(Model.View,null)">show all platforms</a>}@if(Model.View != "all"){<a href="@Link("all",Model.Platform)">All</a>}@if(Model.EmptyMessage == "The feed is empty. Nothing collected yet."){<form action="/collect" method="post"><button class="primary" disabled="@(!Enabled.Any())">Collect now</button></form>}</section>}
else {
 @if(FreshCount>0 && FreshCount<Model.Items.Length){<UnitList Items="Model.Items.Take(FreshCount).ToArray()" Model="Model"/><div class="new-divider">new posts above · @FeedQuery.Relative(Model.Items[FreshCount-1].Lead.Post.PostedAt) and older below</div><UnitList Items="Model.Items.Skip(FreshCount).ToArray()" Model="Model"/>}else{<UnitList Items="Model.Items" Model="Model"/>}
}
</Shell>
@code {
 [Parameter, EditorRequired] public FeedPage Model { get; set; } = null!;
 [Parameter] public string Stamp { get; set; } = "dev";
 [Parameter] public string? Background { get; set; }
 IEnumerable<ViewDefinition> Views => Model.Instance.Taxonomy.Views.Append(new() { Key="all",Label="All" });
 IEnumerable<string> Enabled => Platforms.All.Where(Model.Instance.Config.Enabled);
 IEnumerable<string> PickerPlatforms => Model.KnownPlatforms.Where(p => Model.Instance.Config.Enabled(p) || Model.Platform == p);
 int FreshCount => Model.Scope == "live" && DateTime.TryParse(Model.LastVisit,out var at) ? Model.Items.TakeWhile(u=>u.Lead.Post.PostedAt>at.ToUniversalTime()).Count() : 0;
 Run? LastCollect => Model.Runs.FirstOrDefault(r => r.Kind == "collect" && r.FinishedAt != null && (Model.Platform is null ? Model.Instance.Config.Enabled(r.Platform ?? "") : r.Platform == Model.Platform));
 string CollectLabel => Model.Runs.Any(r => r.Kind == "collect" && r.Status == "running") ? "Collecting…" : Model.Requests.Any(r => r.Kind == "collect") ? "Collect requested ✓" : "Collect";
 bool Open(string p) => !Model.States.Any(s => s.Platform == p && s.NeedsRelogin) && !Model.Runs.Any(r => r.Platform == p && r.Kind == "collect" && r.Status == "running") && !Model.Requests.Any(r => r.Platform == p && r.Kind == "collect");
 bool HasDiagnostics => Model.Issues is { Length: > 0 } || Model.Coverage.Any(c => c.Stale || c.Incomplete) || Model.States.Any(s => s.NeedsRelogin) || Model.Instance.Config.Llm.Enabled && Model.UnsortedCount > 0;
 string DebugTitle => HasDiagnostics ? "Diagnostics to review: processing, warnings or coverage" : "Live debug: runs, scheduler, processes";
 string PlatformTitle(string p) => Model.Instance.Config.Enabled(p) ? p : "Paused by config: not in the default feed; this shows its stored posts";
 string Reason(string p) => Model.States.Any(s=>s.Platform==p&&s.NeedsRelogin) ? "Needs re-login" : Model.Runs.Any(r=>r.Platform==p&&r.Kind=="collect"&&r.Status=="running") ? "Collection is running" : Model.Requests.Any(r=>r.Platform==p&&r.Kind=="collect") ? "Collection is already requested" : Model.States.FirstOrDefault(s => s.Platform == p)?.LastRunFinishedAt is { } at && at.AddMinutes(Model.Instance.Config.Scheduler.ManualCooldownMinutes) > Clock.Now ? $"cooldown: the run starts in {Math.Ceiling((at.AddMinutes(Model.Instance.Config.Scheduler.ManualCooldownMinutes)-Clock.Now).TotalMinutes)} min" : "Queue a bounded collect";
 public static string Link(string view, string? platform, string scope="live") => "/?view=" + Uri.EscapeDataString(view) + (platform is null ? "" : "&platform="+platform) + (scope == "live" ? "" : "&"+scope+"=1");
}
