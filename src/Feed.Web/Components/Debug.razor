<Shell Title="Debug" Stamp="@Stamp" Background="@Background" Blur="Blur" Refresh="true"><header class="toolbar glass"><div class="brand">☷ <strong>debug</strong><small>auto-refresh 10 s</small><a href="/manage">Manage feed</a><a href="/">Back to feed</a><a class="manage-button" href="/manage/backgrounds">Background gallery</a></div></header>
@foreach(var warning in Warnings){<aside class="banner">@warning</aside>}
@if(Error is not null){<aside class="banner">@Error</aside>}
<section class="glass debug"><h2>scheduler</h2><pre>@SchedulerInfo</pre></section>
<section class="glass debug"><h2>collect gates · processing</h2><pre>@Status</pre></section>
<section class="glass debug" id="recovery"><h2>recovery and upstream warnings</h2><DataTable Rows="Issues"/></section>
<section class="glass debug"><h2>recent runs</h2><DataTable Rows="Runs"/></section>
<section class="glass debug"><h2>log tail</h2><a href="/debug/log?file=cli">CLI log</a> · <a href="/debug/log?file=web">Web log</a><pre>@Log</pre></section>
<section class="glass debug"><h2>run requests</h2><DataTable Rows="Requests"/></section>
<section class="glass debug"><h2>posts by platform</h2><DataTable Rows="Posts"/></section>
<section class="glass debug"><h2>like-back queue</h2><DataTable Rows="Likes"/></section>
<section class="glass debug"><h2>platform state</h2><DataTable Rows="States"/></section>
<section class="glass debug"><h2>live config · effective rules</h2><pre>@Rules</pre></section>
<section class="glass debug"><h2>locks</h2><DataTable Rows="Locks"/></section>
<section class="glass debug"><h2>kv</h2><DataTable Rows="Metadata"/></section>
<section class="glass debug" id="coverage"><h2>coverage and timelines</h2><DataTable Rows="Coverage"/></section>
</Shell>
@code{
[Parameter]public string[] Warnings{get;set;}=[];
[Parameter]public string Stamp{get;set;}="dev";[Parameter]public string? Background{get;set;}[Parameter]public double Blur{get;set;}=4;[Parameter]public string? Error{get;set;}[Parameter]public string SchedulerInfo{get;set;}="";[Parameter]public string Status{get;set;}="";[Parameter]public string Rules{get;set;}="";[Parameter]public string Log{get;set;}="";
[Parameter]public object[] Issues{get;set;}=[];
[Parameter]public object[] Runs{get;set;}=[];[Parameter]public object[] Coverage{get;set;}=[];[Parameter]public object[] Requests{get;set;}=[];[Parameter]public object[] Posts{get;set;}=[];[Parameter]public object[] Likes{get;set;}=[];[Parameter]public object[] States{get;set;}=[];[Parameter]public object[] Locks{get;set;}=[];[Parameter]public object[] Metadata{get;set;}=[];
}
