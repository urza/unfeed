<Shell Title="Backgrounds" Stamp="@Stamp" Background="@Model.Selected" Blur="Blur"><div class="management"><ManageNavigation Section="backgrounds"/><section class="glass debug background-settings"><h1>Backgrounds</h1><p>@Model.Images.Length images · blur @Blur px · pinned @(Model.Pinned??"none")</p><p>@Model.Outcome</p><form action="/manage/backgrounds/unpin" method="post"><button>Unpin</button></form><form action="/manage/backgrounds/next" method="post"><button>Next image</button></form></section><section class="glass debug background-settings">
<h2>Your pictures</h2>
<p>Upload JPG, JPEG, PNG or WebP images. Wide landscape pictures work best; 1920 × 1080 is sufficient.</p>
<p>Uploads are saved in <code>backgrounds/local/</code> inside your instance folder (normally <code>data/backgrounds/local/</code>). You can also copy files there yourself; they appear within about a minute.</p>
<p>Click Pin on a picture to keep it selected. Unpinned pictures join the rotation.</p>
@if (UploadMessage is not null) { <p role="status">@UploadMessage</p> }
@if (UploadError is not null) { <p class="banner" role="alert">@UploadError</p> }
<form class="background-upload" action="/manage/backgrounds/upload" method="post" enctype="multipart/form-data">
<label for="background-files">Choose pictures</label>
<input id="background-files" name="images" type="file" accept=".jpg,.jpeg,.png,.webp" multiple required aria-describedby="upload-limits" />
<p id="upload-limits">Up to 10 files, 10 MB each and 20 MB total per upload. Existing files are never overwritten.</p>
<button class="primary" type="submit">Upload files</button>
</form>
</section><div class="background-gallery">@foreach(var image in Model.Images){<article class="glass card"><img src="@($"/backgrounds/{Uri.EscapeDataString(image.Name)}")" alt="@image.Name" loading="lazy"/><p>@image.Source · @image.Name @(Model.Selected==image.Name?" · current":"") @(Model.Pinned==image.Name?" · pinned":"")</p><form method="post" action="/manage/backgrounds/pin"><input type="hidden" name="name" value="@image.Name"/><button>Pin</button></form><form method="post" action="/manage/backgrounds/remove"><input type="hidden" name="name" value="@image.Name"/><button>Remove</button></form></article>}</div></div></Shell>
@code{[Parameter,EditorRequired]public BackgroundSnapshot Model{get;set;}=null!;[Parameter]public string Stamp{get;set;}="dev";[Parameter]public string? UploadMessage{get;set;}[Parameter]public string? UploadError{get;set;}[Parameter]public double Blur{get;set;}=4;}
