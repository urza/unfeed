<Shell Title="Backgrounds" Stamp="@Stamp" Background="@Model.Selected" Blur="Blur"><header class="toolbar glass"><h1>Backgrounds</h1><a href="/">Feed</a> · <a href="/debug">Debug</a></header><section class="glass debug"><p>@Model.Images.Length images · blur @Blur px · pinned @(Model.Pinned??"none")</p><p>@Model.Outcome</p><form action="/debug/backgrounds/unpin" method="post"><button>Unpin</button></form><form action="/debug/backgrounds/next" method="post"><button>Next image</button></form></section><div class="background-gallery">@foreach(var image in Model.Images){<article class="glass card"><img src="@($"/backgrounds/{Uri.EscapeDataString(image.Name)}")" alt="@image.Name" loading="lazy"/><p>@image.Source · @image.Name @(Model.Selected==image.Name?" · current":"") @(Model.Pinned==image.Name?" · pinned":"")</p><form method="post" action="/debug/backgrounds/pin"><input type="hidden" name="name" value="@image.Name"/><button>Pin</button></form><form method="post" action="/debug/backgrounds/remove"><input type="hidden" name="name" value="@image.Name"/><button>Remove</button></form></article>}</div></Shell>
@code{[Parameter,EditorRequired]public BackgroundSnapshot Model{get;set;}=null!;[Parameter]public string Stamp{get;set;}="dev";[Parameter]public double Blur{get;set;}=4;}
