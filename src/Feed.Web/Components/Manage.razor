<Shell Title="Manage" Stamp="@Stamp" Background="@Background" Blur="Model.Instance.Config.Backgrounds.BlurPx">
<div class="management">
<ManageNavigation Section="@Model.Section" HasDiagnostics="@(Model.Failures > 0)"/>
@if(Message is not null){<p class="manage-notice" role="status">@Message</p>}
@if(Error is not null){<p class="banner" role="alert">@Error</p>}
@if(Model.Section == "overview") {
 <section class="manage-panel glass"><div class="manage-heading"><div><h1>Your feed at a glance</h1><p>@(Config.Scheduler.Enabled ? "Automatic scheduling is on." : "Scheduling is paused. Queued actions wait until you resume.") Pausing does not stop work already running.</p></div><form method="post" action="/manage/settings/scheduler">@Token()<input type="hidden" name="enabled" value="@(!Config.Scheduler.Enabled ? "true" : "false")"/><button class="primary">@(Config.Scheduler.Enabled ? "Pause scheduling" : "Resume scheduling")</button></form></div><p>@Model.Pending posts waiting for classification · @Model.Failures posts with processing errors. <a href="/debug#recovery">Review recovery</a></p></section>
 <div class="manage-platforms">@foreach(var p in Model.Platforms){var config = Config.Platform(p.Platform);
  <section class="manage-panel glass"><h2><PlatformGlyph Platform="@p.Platform"/> @Management.PlatformName(p.Platform)</h2>
   <p class="manage-state">@(p.State?.NeedsRelogin == true ? "Login needs attention" : !config.Enabled ? "Platform paused" : p.Running.Length > 0 ? "Working" : p.State?.LastOkRunAt is null ? "Not checked yet" : "Ready · last known session check passed")</p>
   <dl class="manage-facts"><dt>Feed list</dt><dd>@p.Friends people · <a href="@($"/manage?section=people&platform={p.Platform}&filter=friends")">Manage people</a></dd><dt>Posts</dt><dd>@(p.Posts - p.Hidden) visible · @p.Hidden hidden</dd><dt>Last collection</dt><dd>@RunLabel(p.Collection)</dd><dt>Last people refresh</dt><dd>@RunLabel(p.Import)</dd><dt>Next planned run</dt><dd>@p.Next</dd></dl>
   @foreach(var run in p.Running){<p>Running: @run.Kind · @run.Phase · started @At(run.StartedAt)</p>}
   @foreach(var request in p.Requests){<p>Queued work: @request.Kind · @request.Status @request.Note</p>}
   <div class="manage-actions">@foreach(var mode in Platforms.Modes){<form method="post" action="@($"/manage/platform/{p.Platform}/collect")">@Token()<input type="hidden" name="mode" value="@mode"/><button disabled="@(!Config.Scheduler.Enabled || !config.Enabled || p.State?.NeedsRelogin == true)">Collect · @Management.ModeName(mode)</button></form>}
   <form method="post" action="@($"/manage/platform/{p.Platform}/friends")">@Token()<button disabled="@(!Config.Scheduler.Enabled || !config.Enabled || p.State?.NeedsRelogin == true)">Refresh @(p.Platform == "facebook" ? "friends" : "following")</button></form></div>
   <p class="muted">Refresh adds newly discovered people. It does not remove people missing from the platform list.</p>
   <details><summary>Platform settings and login</summary><form method="post" action="/manage/settings/platform">@Token()<input type="hidden" name="platform" value="@p.Platform"/><label><input type="checkbox" name="enabled" value="true" checked="@config.Enabled"/> Enable platform</label><label><input type="checkbox" name="likeback" value="true" checked="@config.Likeback"/> Allow sending hearts when I press Like-back</label><button>Save platform settings</button></form>
   <p>Open your configured noVNC browser, then start login here. Enter your credentials and complete any challenge yourself in that browser. Scheduling must be on to start the queued login.</p><form method="post" action="@($"/manage/platform/{p.Platform}/login")">@Token()<button disabled="@(!Config.Scheduler.Enabled)">Start login</button></form></details>
  </section>
 }</div>
 <section class="manage-panel glass"><h2>Appearance</h2><a href="/manage/backgrounds">Choose or upload a background</a></section>
}
else if(Model.Section == "people") {
 <section class="manage-panel glass"><h1>People</h1><p>These are local records, not a live check of friendship or following on the platforms. Close friends and mute settings affect this app only.</p>
 <form method="get" action="/manage" class="people-search"><input type="hidden" name="section" value="people"/><label>Search<input name="q" value="@Model.Query" placeholder="Name or handle"/></label><label>Platform<select name="platform"><option value="">Both platforms</option>@foreach(var p in Platforms.All){<option value="@p" selected="@(Model.Platform == p)">@Management.PlatformName(p)</option>}</select></label><label>Show<select name="filter">@foreach(var f in PeopleFilters){<option value="@f.Key" selected="@(Model.Filter == f.Key)">@f.Label</option>}</select></label><button>Search</button></form>
 <p>@Model.PeopleCount people · page @Model.Page of @Pages</p>
 <div class="manage-table-scroll"><table class="people-table"><thead><tr><th>Person</th><th>Feed list</th><th>Close friend</th><th>Muted</th><th>Always show</th><th>Activity and actions</th></tr></thead><tbody>
 @foreach(var row in Model.People){var person = row.Author;<tr data-person="@person.Id"><td><div class="person-name">@if(person.AvatarPath is not null){<img class="avatar" src="@("/" + person.AvatarPath)" alt="" loading="lazy"/>}<div><a href="@SafeUrl(person.Url)" target="_blank" rel="noopener noreferrer">@(person.DisplayName ?? "Unknown person")</a><small>@Management.PlatformName(person.Platform)</small></div></div></td><td data-label="Feed list">@(person.IsFriend ? "Friend / followed" : "Not in feed list")</td>
  @foreach(var toggle in new[]{("close", "Close friend", row.Close), ("mute", "Muted", row.Muted), ("always", "Always show", row.Always)}){<td data-label="@toggle.Item2"><form method="post" action="@($"/manage/people/{person.Id}/{toggle.Item1}")">@Token()<input type="hidden" name="enabled" value="@(!toggle.Item3 ? "true" : "false")"/><button class="state-toggle @(toggle.Item3 ? "is-on" : "")" aria-label="@($"{toggle.Item2}: {person.DisplayName}")" aria-pressed="@(toggle.Item3 ? "true" : "false")" disabled="@(toggle.Item1 == "close" && !person.IsFriend)">@(toggle.Item3 ? "On" : "Off")</button></form></td>}
  <td><details><summary>@row.Posts posts · @(row.Posts - row.Hidden) visible</summary><p>Latest captured post: @At(row.Latest)</p><p>Last encountered by the app: @At(person.LastSeenAt)</p><p>Last profile check: @(row.Visit is null ? "Not checked" : At(row.Visit.At) + " · " + row.Visit.CaptureStatus)</p>@if(row.Visit?.Note is not null){<p>@row.Visit.Note</p>}@if(row.Retry is not null){<p>@row.Retry</p>}<p class="person-refs">@string.Join(" · ", Identity.Keys(person))</p>
  @if(person.IsFriend){<details><summary>Remove from feed list</summary><p>Stops future profile sweeps and removes the close-friend and extra home-visit entries. Stored posts remain, subject to audience rules. A later platform import may add this person back. Use Mute to keep hiding them.</p><form method="post" action="@($"/manage/people/{person.Id}/remove")">@Token()<button>Remove from feed list</button></form></details>}
  </details></td></tr>}
 </tbody></table></div>
 @if(Model.People.Length == 0){<p>No people match this search.</p>}
 <nav class="manage-pagination" aria-label="People pages">@if(Model.Page > 1){<a href="@PeoplePage(Model.Page - 1)">← Previous</a>}@if(Model.Page < Pages){<a href="@PeoplePage(Model.Page + 1)">Next →</a>}</nav>
 <details><summary>How these controls work</summary><p>Mute hides posts and overrides Always show. Always show bypasses only the filters selected in Rules; it does not grant a category or membership in a view. Close-friend additions affect future collection and classification. Existing excluded categories require explicit rescoring. Removing a close friend immediately removes restricted categories from stored verdicts.</p><p>Edits reapply deterministic filters to stored posts. Processing or imports may need to finish before you can save.</p></details>
 </section>
}
else if(Model.Section == "schedule") {
 <section class="manage-panel glass"><h1>Schedule</h1><p>Times use @Config.Zone.Id. Next runs are planned times; browser work, login issues and cooldowns can delay or prevent a run. Saving does not repeat a slot already run today.</p><form method="post" action="/manage/settings/scheduler">@Token()<label><input type="checkbox" name="enabled" value="true" checked="@Config.Scheduler.Enabled"/> Automatic scheduling enabled</label><button>Save scheduling state</button></form><details><summary>Timezone and timing</summary><form method="post" action="/manage/settings/timing">@Token()<ManageField Label="Timezone" Name="timezone" Value="@Config.Zone.Id" Hint="For example Europe/Prague or UTC"/><ManageField Label="Random delay, maximum minutes" Name="jitter_minutes" Type="number" Value="@Config.Scheduler.JitterMinutes.ToString()"/><ManageField Label="Cooldown between manual collections, minutes" Name="manual_cooldown_minutes" Type="number" Value="@Config.Scheduler.ManualCooldownMinutes.ToString()"/><button>Save timing</button></form></details></section>
 @foreach(var platform in Model.Platforms){var settings = Config.Platform(platform.Platform);<section class="manage-panel glass"><h2>@Management.PlatformName(platform.Platform)</h2><p>Next: @platform.Next</p><div class="schedule-grid">@foreach(var mode in Platforms.Modes){var interval = settings.ScheduleIntervals.GetValueOrDefault(mode);var days = settings.ScheduleDays.GetValueOrDefault(mode);<form method="post" action="/manage/settings/schedule" class="schedule-form">@Token()<input type="hidden" name="platform" value="@platform.Platform"/><input type="hidden" name="mode" value="@mode"/><h3>@Management.ModeName(mode)</h3><ManageField Label="Times" Name="times" Value="@string.Join(", ", settings.Schedule.GetValueOrDefault(mode, []))" Hint="24-hour times separated by commas, e.g. 08:00, 18:30. Leave empty to disable this mode."/><fieldset><legend>Days of the week</legend><div class="weekday-options">@foreach(var day in Weekdays){<label><input type="checkbox" name="days" value="@day" checked="@(days.IsDefaultOrEmpty || days.Contains(day))"/>@day</label>}</div><small>No selection means every day.</small></fieldset><ManageField Label="Every N days" Name="interval" Type="number" Value="@((interval?.Days ?? 1).ToString())"/><ManageField Label="Starting date" Name="start" Type="date" Value="@(interval?.StartDate.ToString("yyyy-MM-dd"))" Hint="Required for intervals longer than one day. Weekdays and interval both apply."/><button>Save @Management.ModeName(mode)</button></form>}</div></section>}
}
else if(Model.Section == "rules") {
 <section class="manage-panel glass"><h1>Feed rules</h1><p>Saved keyword and deterministic filter changes apply to stored posts immediately. AI policy changes apply to future judgments; history needs an explicit rescore.</p>
 <form method="post" action="/manage/settings/rules">@Token()<ManageField Label="Blocked phrases" Name="keywords" Multiline="true" Value="@string.Join('\n', Model.Instance.Preferences.Keywords)" Hint="One phrase per line; matched in captions and shared text."/><ManageField Label="Your written policy" Name="policy" Multiline="true" Rows="8" Value="@string.Join('\n', Model.Instance.Preferences.Policy)" Hint="One instruction per line. This guides the model's visibility score."/><ManageField Label="Rules learned from feedback" Name="learned" Multiline="true" Value="@string.Join('\n', Model.Instance.Preferences.Learned)" Hint="These are interpreted rules, not automatic bans from individual thumbs."/><ManageField Label="Muted people" Name="muted" Multiline="true" Value="@string.Join('\n', Model.Instance.Preferences.Mutes)" Hint="One name or platform reference per line. These rules remain even if a person is absent from the imported list."/><ManageField Label="Always show people" Name="always" Multiline="true" Value="@string.Join('\n', Model.Instance.Preferences.Shows)" Hint="One name or platform reference per line. Mute still wins."/><button>Save written rules</button></form></section>
 <section class="manage-panel glass"><h2>Visibility filters</h2><form method="post" action="/manage/settings/filters">@Token()<label>Audience<select name="audience"><option value="friends_and_followed" selected="@(Config.Filters.Audience == "friends_and_followed")">Friends and followed people</option><option value="all_captured" selected="@(Config.Filters.Audience == "all_captured")">Everyone captured</option></select></label><label>Allow posts tagging a friend<select name="friend_tag_exception">@foreach(var item in new[]{("none","Never"),("with","Only an “is with” tag"),("any","Any friend tag")}){<option value="@item.Item1" selected="@(Config.Filters.FriendTagException == item.Item1)">@item.Item2</option>}</select></label><fieldset><legend>Block these post types</legend>@foreach(var type in new[]{"sponsored","suggested","event","reel"}){<label><input type="checkbox" name="blocked_types" value="@type" checked="@Config.Filters.BlockedTypes.Contains(type)"/>@type</label>}</fieldset><fieldset><legend>Always show bypasses</legend>@foreach(var gate in new[]{("types","Blocked post types"),("audience","Audience restriction"),("keyword","Blocked phrases"),("llm","AI visibility score")}){<label><input type="checkbox" name="bypasses" value="@gate.Item1" checked="@Config.Filters.AlwaysShowBypasses.Contains(gate.Item1)"/>@gate.Item2</label>}</fieldset><p>Mute always wins. Manage muted and always-show people in <a href="/manage?section=people">People</a>.</p><button>Save visibility filters</button></form></section>
}
else if(Model.Section == "categories") {
 <section class="manage-panel glass"><h1>Categories and views</h1><p>Definitions guide future model judgments. Restriction changes refilter stored labels; changed meanings need explicit rescoring. Views select posts and never bypass visibility filters.</p></section>
 @foreach(var category in Model.Instance.Taxonomy.Categories){<section class="manage-panel glass"><h2>@category.Label</h2><form method="post" action="/manage/settings/category">@Token()<input type="hidden" name="key" value="@category.Key"/><ManageField Label="Label" Name="label" Value="@category.Label"/><ManageField Label="Meaning" Name="definition" Multiline="true" Rows="5" Value="@category.Definition"/><fieldset><legend>Only close friends may receive this category on</legend>@foreach(var platform in Platforms.All){<label><input type="checkbox" name="close_friends_only" value="@platform" checked="@category.CloseFriendsOnly.Contains(platform)"/>@Management.PlatformName(platform)</label>}</fieldset><label><input type="checkbox" name="default" value="true" checked="@category.Default"/> Use when no other category fits (at most one default)</label><button>Save category</button></form></section>}
 @foreach(var view in Model.Instance.Taxonomy.Views){<section class="manage-panel glass"><h2>View · @view.Label</h2><form method="post" action="/manage/settings/view">@Token()<input type="hidden" name="key" value="@view.Key"/><ManageField Label="Label" Name="label" Value="@view.Label"/>
 @if(view.Category is not null){<label>Category<select name="category">@foreach(var c in Model.Instance.Taxonomy.Categories){<option value="@c.Key" selected="@(view.Category == c.Key)">@c.Label</option>}</select></label>}
 @if(view.Authors is not null){<ManageField Label="People included" Name="authors" Multiline="true" Value="@string.Join('\n', view.Authors.Value)" Hint="One name or exact platform reference per line; references are shown in People details."/>}
 @if(view.Union is not null){<fieldset><legend>Include these views</legend>@foreach(var member in Model.Instance.Taxonomy.Views.Where(v => v.Union is null)){<label><input type="checkbox" name="members" value="@member.Key" checked="@view.Union.Value.Contains(member.Key)"/>@member.Label</label>}</fieldset>}
 @if(view.Rare is not null){<ManageField Label="Maximum posts" Name="max_posts" Type="number" Value="@view.Rare.MaxPosts.ToString()"/><ManageField Label="Within this many days" Name="window_days" Type="number" Value="@view.Rare.WindowDays.ToString()"/>}
 <button>Save view</button></form></section>}
 @if(Model.Instance.Taxonomy.Categories.IsEmpty && Model.Instance.Taxonomy.Views.IsEmpty){<p>No categories or views are configured yet. Add their initial definitions in taxonomy.json.</p>}
}
else if(Model.Section == "storage") {
 <section class="manage-panel glass"><h1>Storage</h1><p>@Model.Disk</p><p class="muted">Last measurement: @Model.DiskAt</p><form method="post" action="/manage/settings/storage">@Token()<ManageField Label="Keep raw captures, days" Name="raw_retention_days" Type="number" Value="@Config.RawRetentionDays.ToString()"/><ManageField Label="Keep hidden media, days" Name="hidden_media_retention_days" Type="number" Value="@Config.HiddenMediaRetentionDays.ToString()"/><ManageField Label="Keep hidden videos, days" Name="hidden_video_retention_days" Type="number" Value="@Config.HiddenVideoRetentionDays.ToString()"/><ManageField Label="Keep videos, days" Name="video_retention_days" Type="number" Value="@Config.VideoRetentionDays.ToString()"/><ManageField Label="Maximum video size, MB" Name="max_video_mb" Type="number" Value="@Config.MaxVideoMb.ToString()"/><p>Zero days disables that retention rule. Shorter retention can delete eligible files during the next scheduled cleanup. This keeps post records; it does not delete posts.</p><button>Save retention settings</button></form></section>
}
else if(Model.Section == "processing") {
 <section class="manage-panel glass"><h1>AI processing</h1><p>@Model.Pending posts awaiting judgment · @Model.Failures posts with errors. <a href="/debug#recovery">Inspect failures and retry status</a></p><form method="post" action="/manage/work/process">@Token()<button disabled="@(!Config.Scheduler.Enabled)">Process pending work</button></form><p>Retry delays and limits still apply. This does not rescore previously completed posts.</p><p>Model: @Config.Llm.Model. Endpoint and credentials remain in your instance configuration.</p><form method="post" action="/manage/settings/processing">@Token()<label><input type="checkbox" name="enabled" value="true" checked="@Config.Llm.Enabled"/> Enable AI classification and summaries</label><label><input type="checkbox" name="vision" value="true" checked="@Config.Llm.Vision"/> Include images in classification</label><ManageField Label="Hide scores below" Name="threshold" Type="number" Value="@Config.Llm.Threshold.ToString()" Hint="0–10. Applies to new judgments; history needs explicit rescoring."/><ManageField Label="Concurrent model requests" Name="parallel" Type="number" Value="@Config.Llm.Parallel.ToString()"/><ManageField Label="Request timeout, seconds" Name="timeout_seconds" Type="number" Value="@Config.Llm.TimeoutSeconds.ToString()"/><ManageField Label="Judgment token budget" Name="max_tokens" Type="number" Value="@Config.Llm.MaxTokens.ToString()"/><ManageField Label="Summary token budget" Name="summary_max_tokens" Type="number" Value="@Config.Llm.SummaryMaxTokens.ToString()"/><ManageField Label="Summary languages" Name="summary_languages" Multiline="true" Value="@string.Join('\n', Config.Llm.SummaryLanguages)" Hint="One language per line. Posts in other languages are summarized in English."/><button>Save processing settings</button></form></section>
}
<p class="manage-footnote">Changes save to your instance files. Keep editing those files directly if you prefer; stale browser forms cannot overwrite newer edits. This page does not refresh while you edit. <a href="@($"/manage?section={Model.Section}")">Refresh status</a>.</p>
</div>
</Shell>
@code {
 [Parameter, EditorRequired] public ManagementPage Model { get; set; } = null!;
 [Parameter] public string Stamp { get; set; } = "dev";
 [Parameter] public string? Background { get; set; }
 [Parameter] public string RequestToken { get; set; } = "";
 [Parameter] public string? Message { get; set; }
 [Parameter] public string? Error { get; set; }
 FeedConfig Config => Model.Instance.Config;
 int Pages => Math.Max(1, (Model.PeopleCount + 39) / 40);
 static readonly (string Key, string Label)[] PeopleFilters = [("","All known people"),("friends","Friends / followed"),("close","Close friends"),("muted","Muted"),("always","Always show"),("removed","Not in feed list")];
 static readonly string[] Weekdays = ["mon","tue","wed","thu","fri","sat","sun"];
 RenderFragment Token() => @<ManageToken Token="@RequestToken" Version="@Model.Documents.Version" Section="@Model.Section" Query="@Model.Query" Platform="@Model.Platform" Filter="@Model.Filter" Page="@Model.Page"/>;
 static string At(DateTime? at) => at is null ? "Never" : at.Value.ToString("yyyy-MM-dd HH:mm 'UTC'");
 static string RunLabel(Run? run) => run is null ? "Never" : $"{At(run.StartedAt)} · {run.Status}";
 string PeoplePage(int page) => $"/manage?section=people&q={Uri.EscapeDataString(Model.Query)}&platform={Model.Platform}&filter={Model.Filter}&page={page}";
 static string? SafeUrl(string? value) => Uri.TryCreate(value, UriKind.Absolute, out var url) && url.Scheme is "http" or "https" ? value : null;
}
