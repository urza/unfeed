<article class="card glass @(Model.Scope == "hidden" ? "hidden-card" : "")" id="@($"post-{P.Id}")" data-post="@P.Id">
@if(P.Hidden){<div class="hidden-tag">hidden · @P.HiddenBy: @P.HiddenReason</div>}
<header class="card-head">@if(Card.Author?.AvatarPath is {} avatar){<img class="avatar" src="@("/"+avatar)" alt="" loading="lazy" width="40" height="40"/>}else{<span class="avatar fallback">@(Name.Length > 0 ? Name[..1] : "?")</span>}<div>@if(Card.Author is { } author){<a class="author" href="@($"/people/{author.Id}")">@Name</a>}else{<a class="author" href="@FeedQuery.SafeUrl(P.ObservedAuthorUrl)" target="_blank" rel="noopener noreferrer">@Name</a>}<div class="meta"><span>@P.Platform</span> · <time title="@P.PostedAt?.ToString("O")">@FeedQuery.Relative(P.PostedAt)</time></div></div></header>
@if(P.SharedAuthor is not null || P.SharedText is not null || P.SharedUrl is not null){<p class="share-attribution">@Name shared @if(P.SharedAuthor is not null){<span>a post by <a href="@FeedQuery.SafeUrl(P.SharedUrl)" target="_blank" rel="noopener noreferrer">@P.SharedAuthor</a></span>}else{<a href="@FeedQuery.SafeUrl(P.SharedUrl)" target="_blank" rel="noopener noreferrer">a post</a>}</p>}
@if(P.StoryTitle is not null){<p class="story-context"><RichText Text="@P.StoryTitle"/></p>}
<div class="badges">@if(P.IsSponsored){<span class="badge sponsored">sponsored</span>}@if(P.IsSuggested){<span class="badge suggested">suggested</span>}@if(P.IsReel){<span class="badge">reel</span>}@if(P.IsEvent){<span class="badge event">event</span>}@if(Card.Why is not null){<span class="badge why-badge" title="Why this post is in this view">@Card.Why</span>}@if(Badge is not null){<span class="badge stack-badge">@Badge</span>}</div>
@if(currentSummary is not null){<div class="summary"><small>summary</small><em><RichText Text="@currentSummary"/></em></div>}
@if(currentSummary is not null){<input class="text-toggle" type="checkbox" id="@($"expand-{P.Id}")" aria-controls="@($"text-{P.Id}")" aria-label="Show full text"/>}
<div class="text-body" id="@($"text-{P.Id}")">
@if(withTags.Length > 0){<p>with @foreach(var tag in withTags){<a href="@FeedQuery.SafeUrl(tag.Url)">@tag.Name</a><span> </span>}</p>}
@if(!string.IsNullOrEmpty(P.Text)){<div class="caption"><RichText Text="@P.Text" Tags="@tags"/></div>}
@if(P.SharedAuthor is not null || P.SharedText is not null){<div class="shared"><small>shared · </small><a href="@FeedQuery.SafeUrl(P.SharedUrl)" target="_blank" rel="noopener noreferrer">@P.SharedAuthor</a><div><RichText Text="@P.SharedText"/></div></div>}
@if(P.MemoryLabel is not null || P.MemoryText is not null){<div class="memory"><small>memory · @P.MemoryLabel</small><div><RichText Text="@P.MemoryText"/></div></div>}
</div>
@if(posterPair){var image=files[0].Kind=="image"?files[0]:files[1];var video=files[0].Kind=="video"?files[0]:files[1];<div class="media mosaic-1"><video src="@("/"+video.Path)" poster="@("/"+image.Path)" controls preload="none" playsinline width="@image.Width" height="@image.Height"></video><a class="extra-media" href="@("/"+image.Path)">Open poster image</a></div>}
else if(files.Length > 0){<div class="media mosaic-@(Math.Min(files.Length,3))" data-gallery>
@foreach(var index in tileIndexes){var file=files[index];<a href="@("/"+file.Path)" class="media-tile" data-index="@index" data-kind="@file.Kind" aria-label="@(file.Kind == "video" ? "Play video" : "Open image")">
@if(file.Kind == "video") { <video src="@("/"+file.Path)" controls="@(files.Length == 1)" preload="metadata" playsinline width="@file.Width" height="@file.Height" muted="@(files.Length > 1)"></video>@if(files.Length>1){<span class="play">▶</span>} }
else {<img src="@("/"+file.Path)" loading="lazy" alt="Post image" width="@file.Width" height="@file.Height"/>}
@if(files.Length>3 && index==tileIndexes[^1]){<span class="more" data-index="@firstSkipped">+@(files.Length-3)</span>}
</a>}
@foreach(var index in extraIndexes){<a href="@("/"+files[index].Path)" class="extra-media" data-index="@index" data-kind="@files[index].Kind">Open media @(index+1)</a>}
</div>}
@if(prunedCount>0){<p class="retention" title="@prunedTooltip">@(prunedCount==1 ? "one media file not stored" : $"{prunedCount} media files not stored")@if(P.Permalink is not null){<span>, the original is linked below</span>}</p>}
@if(currentSummary is not null){<label class="expand-chip chip" for="@($"expand-{P.Id}")"><span class="show-full">show full text</span><span class="show-less">show less</span></label>}
<footer class="card-footer">
<form method="post" action="@($"/posts/{P.Id}/thumbs/up?view={Uri.EscapeDataString(Model.View)}&scope={Model.Scope}")" data-action="thumb"><button class="chip @(Card.Up>0?"voted":"")" title="More like this (remembered for this author)">👍 <span data-count>@(Card.Up>0?Card.Up.ToString():"")</span></button></form><form method="post" action="@($"/posts/{P.Id}/thumbs/down?view={Uri.EscapeDataString(Model.View)}&scope={Model.Scope}")" data-action="thumb"><button class="chip @(Card.Down>0?"voted":"")" title="Less like this (remembered for this author)">👎 <span data-count>@(Card.Down>0?Card.Down.ToString():"")</span></button></form>
@if(offerHeart){<form method="post" action="@($"/posts/{P.Id}/like")" data-action="heart"><button class="chip" disabled="@(Card.Like?.State is "pending" or "sent")" title="@(Card.Like?.State == "pending" ? $"Sending the heart to {P.Platform}" : Card.Like?.State == "sent" ? $"Heart sent to {P.Platform} (the agent's only write)" : Card.Like?.Error ?? $"Like-back: heart the original post on {P.Platform} (the agent's only write)")" data-state="@(Card.Like?.State??"none")">@(Card.Like?.State=="sent"?"❤️":"♥")</button></form>}
@if(P.Permalink is not null){<a class="chip" href="@FeedQuery.SafeUrl(P.Permalink)" target="_blank" rel="noopener noreferrer" title="@($"Open the original post on {P.Platform}")" aria-label="Open original">↗</a>}
@if(Model.Scope=="hidden"){<form method="post" action="@($"/posts/{P.Id}/unhide")" data-action="unhide"><button class="chip" title="Release this post back to the feed">unhide</button></form>}
<span class="categories" title="@($"LLM categories, score {P.LlmScore}")">@categoriesText</span><small title="Internal post id; quote it when giving feedback">#@P.Id</small>
</footer><details class="why"><summary class="chip" title="The decisions behind this post: your rules, verdict, view">why</summary><ul>@foreach(var line in Card.Trail){<li>@line</li>}</ul></details>
</article>
@code {
 [Parameter,EditorRequired] public Card Card {get;set;}=null!;
 [Parameter,EditorRequired] public FeedPage Model {get;set;}=null!;
 [Parameter] public string? Badge {get;set;}
 Post P=>Card.Post; string Name=>Card.Author?.DisplayName??P.ObservedAuthorName??"Unknown author";
 Tag[] tags=[]; Tag[] withTags=[]; Media[] files=[]; int[] tileIndexes=[]; int[] extraIndexes=[]; int firstSkipped; bool posterPair; int prunedCount; string prunedTooltip=""; string? currentSummary; string categoriesText=""; bool offerHeart;
 protected override void OnParametersSet()
 {
  var p = Card.Post;
  currentSummary = p.SummaryContentRevision == p.ContentRevision && !string.IsNullOrWhiteSpace(p.Summary) ? p.Summary : null;
  tags = Feed.Core.Domain.Filters.Tags(p);
  withTags = tags.Length == 0 ? [] : tags.Where(t => t.Kind == "with").ToArray();
  files = Card.Media.Length == 0 ? [] : Card.Media.Where(m => m.Path != null).ToArray();
  posterPair = files.Length == 2 && (files[0].Kind == "image" && files[1].Kind == "video" || files[0].Kind == "video" && files[1].Kind == "image");
  int n = files.Length;
  if (n == 0) { tileIndexes = []; extraIndexes = []; firstSkipped = 0; }
  else if (n <= 3) { tileIndexes = n == 1 ? [0] : n == 2 ? [0, 1] : [0, 1, 2]; extraIndexes = []; firstSkipped = 0; }
  else
  {
   var video = Array.FindIndex(files, m => m.Kind == "video");
   tileIndexes = video >= 3 ? [0, video, 1] : [0, 1, 2];
   var extras = new List<int>(n - 3);
   for (int i = 0; i < n; i++) if (Array.IndexOf(tileIndexes, i) < 0) extras.Add(i);
   extraIndexes = extras.ToArray();
   firstSkipped = extras.Count > 0 ? extras[0] : 0;
  }
  prunedCount = 0;
  foreach (var m in Card.Media) if (m.PrunedAt != null) prunedCount++;
  prunedTooltip = prunedCount == 0 ? "" : string.Join("; ", Card.Media.Where(m => m.PrunedAt != null).Select(m => m.Error).Distinct());
  categoriesText = p.Judged ? string.Join(" · ", System.Text.Json.JsonSerializer.Deserialize<string[]>(p.CategoriesJson!) ?? []) : "";
  offerHeart = Model.Instance.Config.Platform(p.Platform).Likeback && p.LikeRef is not null && p.Permalink is not null;
 }
}
